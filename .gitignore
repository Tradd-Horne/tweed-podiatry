# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# /out/ is COMMITTED on purpose — see Dockerfile. The droplet serves it, never builds it.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Twilio credentials for the lead relay. Created on the droplet, never committed.
relay/.env
# Lead history lives on the droplet, not in git.
relay/data/*
!relay/data/.gitkeep
# Byte-code from running the relay locally.
relay/__pycache__/
